# 시연 서버 설정 예시. 이 파일에는 키 이름만 둔다(값을 넣지 않는다).
# 실제 값은 같은 디렉터리의 .env에 넣는다. .env는 .gitignore에 있어 커밋되지 않는다.
# npm run demo:server는 .env가 있으면 읽고(node --env-file-if-exists=.env), 없어도 그대로 시작한다.

# 시연 API 포트와 바인딩 주소 (기본 8787, 127.0.0.1)
PORT=
HOST=

# 로컬 온체인 기록용 RPC 주소 (기본 http://127.0.0.1:8545).
# 닿지 않으면 서버가 node_modules의 hardhat으로 hardhat node를 자식 프로세스로 띄운다.
DEMO_ATTEST_RPC_URL=
# off로 두면 온체인 기록 기능을 끈다
DEMO_ATTEST=

# EAS + Sepolia 기록용 (4c에서 구현 예정, 지금은 읽지 않는다)
EAS_RPC_URL=
EAS_PRIVATE_KEY=
