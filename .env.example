# 시연 서버 설정 예시. 이 파일에는 키 이름만 둔다(값을 넣지 않는다).
# 실제 값은 같은 디렉터리의 .env에 넣는다. .env는 .gitignore에 있어 커밋되지 않는다.
# npm run demo:server는 .env가 있으면 읽고(node --env-file-if-exists=.env), 없어도 그대로 시작한다.

# 시연 API 포트와 바인딩 주소 (기본 8787, 127.0.0.1)
PORT=
HOST=

# 로컬 온체인 기록용 RPC 주소 (기본 http://127.0.0.1:8545).
# 닿지 않으면 서버가 node_modules의 hardhat으로 hardhat node를 자식 프로세스로 띄운다.
DEMO_ATTEST_RPC_URL=
# off로 두면 온체인 기록 기능을 끈다
DEMO_ATTEST=

# EAS 공개 체인 기록용 (eas-sepolia). 모두 선택. DEMO_EAS_RPC_URL이 없으면 eas-sepolia는 "미설정".
# 키가 없으면 읽기 전용(조회·검증만). 키와 RPC 주소는 서버 로그·API 응답·스크립트 출력에 나오지 않는다.
# 이 변수들은 이름에 EAS_가 들어 있어 시뮬레이션 하위 프로세스에는 전달되지 않는다(demo/run.js).
DEMO_EAS_RPC_URL=
# 기록용 계정 키 (테스트넷 전용 새 지갑을 쓸 것, 실제 자금이 있는 키 금지)
DEMO_EAS_PRIVATE_KEY=
# 기본값: Sepolia EAS 0xC2679fBD37d54388Ce493F1DB75320D236e1815e, SchemaRegistry 0x0a7E2Ff54e76B8E6659aedc9103FB21c038050D0,
# 체인 ID 11155111, 탐색기 https://sepolia.easscan.org
DEMO_EAS_ADDRESS=
DEMO_EAS_SCHEMA_REGISTRY=
DEMO_EAS_CHAIN_ID=
DEMO_EAS_EXPLORER_BASE=
